# Web Designing Lab - Academic Repository
# Professional .gitattributes for scholarly archiving

# Set default behavior to automatically normalize line endings
* text=auto

# Ensure text and source files use LF on checkout
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.php text eol=lf
*.json text eol=lf
*.cff text eol=lf
LICENSE text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.svg text

# Multimedia
*.mp4 binary
*.mp3 binary
*.webm binary
*.ogg binary

# Improve diff handling
*.md text diff=markdown
*.html text diff=html
*.css text
*.js text
