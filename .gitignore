# Web Designing Lab - Academic Repository
# Specialized .gitignore for web development and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# Web Artifacts (Node.js / Frontend)
node_modules/
bower_components/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.parcel-cache/
.next/
.serverless/
.fusebox/
.dynamodb/

# PHP Artifacts
vendor/
composer.lock
*.phpunit.result.cache

# Temporary and Cache files
*.tmp
*.log
.cache/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
